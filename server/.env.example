# ---- Server ----
# 5050, not 5000: on macOS the AirPlay Receiver (ControlCenter) listens on
# port 5000 by default, which makes the API fail to bind with EADDRINUSE.
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
# Local MongoDB:   mongodb://127.0.0.1:27017/smart_restaurant
# MongoDB Atlas:   mongodb+srv://<user>:<pass>@<cluster>/smart_restaurant
MONGO_URI=mongodb://127.0.0.1:27017/smart_restaurant

# ---- Auth ----
# Generate a strong random value before deploying, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---- Reservation engine ----
# Seating slots are fixed and non-overlapping. This is what makes the
# double-booking guarantee a single atomic unique index.
SLOT_MINUTES=90
OPEN_TIME=11:00
CLOSE_TIME=23:00
# Minutes ahead of UTC for the restaurant's local timezone (330 = IST, UTC+5:30).
RESTAURANT_UTC_OFFSET_MINUTES=330
# How many days into the future customers may book.
MAX_BOOKING_DAYS_AHEAD=60

# ---- Payments (Razorpay) ----
# PAYMENT_PROVIDER=razorpay turns on online payment. Leave it as `none` and the
# app still works end to end — every order is simply marked "pay at restaurant".
# Nothing here is required to run or demo the project.
#
# Get test keys at https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Test keys start with rzp_test_ and move no real money.
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this to the secret you enter when creating the webhook in the Razorpay
# dashboard, pointing at  POST <your-api-url>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_EMAIL=admin@restaurant.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_STAFF_EMAIL=staff@restaurant.test
SEED_STAFF_PASSWORD=Staff@12345

# Optional. Enables Claude for dish descriptions, review analysis and the menu
# chatbot. Without it those three fall back to the built-in engines; every other
# feature is unaffected.
ANTHROPIC_API_KEY=
